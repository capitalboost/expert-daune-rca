Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
# Canonical host, preserving path and query string.
RewriteCond %{HTTP_HOST} ^www\.expertdaunerca\.ro$ [NC]
RewriteRule ^ https://expertdaunerca.ro%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{THE_REQUEST} "\s/[^?\ ]*index\.html(?:[?\ ]|$)"
